@{
    ViewData["Title"] = "Produse";
}

<br />
<br />

<div class="container my-4">

    @if (ViewBag.GoodMsg != null) {

        <div class="alert alert-success" role="alert">
            @ViewBag.GoodMsg
        </div>
    }
    else if (ViewBag.BadMsg != null)
    {
        <div class="alert alert-danger" role="alert">
            @ViewBag.BadMsg
        </div>
    }

    <form method="get" asp-action="Index" class="row g-3 mb-4 p-3 border rounded bg-light" role="search">

        <div class="col-md-6">
            <label class="form-label">🔍 Caută produs sau categorie</label>
            <input type="search" 
                   class="form-control me-2" 
                   name="search"
                   placeholder="Search"
                   value="@ViewBag.SearchString" />
        </div>

        <div class="col-md-4">
            <label class="form-label">🔃 Sortează după</label>
            <select class="form-select" name="sort" onchange="this.form.submit()">
                <!option value="" @(ViewBag.SortOrder == null ? "selected" : "")>-- Implicit --</!option>
                <!option value="price_asc" @(ViewBag.Sort == "price_asc" ? "selected" : "")>Preț crescător</!option>
                <!option value="price_desc" @(ViewBag.Sort == "price_desc" ? "selected" : "")>Preț descrescător</!option>
                <!option value="rating_asc" @(ViewBag.Sort == "rating_asc" ? "selected" : "")>Rating crescător</!option>
                <!option value="rating_desc" @(ViewBag.Sort == "rating_desc" ? "selected" : "")>Rating descrescător</!option>
            </select>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-outline-success">Filtrează</button>
        </div>

        <div class="col-12">
            <a asp-action="Index" class="text-decoration-none small text-muted">✖ Resetează filtrele</a>
        </div>
    </form>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-4 g-4">

        @foreach (var p in ViewBag.Products) {
            <div class="col">
                <div class="card h-100 product-card">

                    <div class="d-flex align-items-center justify-content-center p-3">
                        <img src="@p.Image"
                             class="img-fluid product-img"
                             alt="Product image" />
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title">@p.Title</h6>

                        <div><i class="bi bi-globe"></i> @p.Category.CategoryName</div>

                        <div class="mt-auto fw-bold text-danger fs-5">
                            @p.Price Lei
                        </div>

                        <a asp-controller="Products"
                           asp-action="Show"
                           asp-route-id="@p.Id"
                           class="btn btn-primary mt-2">
                            
                           Afișează produs
                        </a>

                        <a asp-controller="Cart"
                           asp-action="Add"
                           asp-route-id="@p.Id"
                           class="btn btn-primary mt-2">

                            Adaugă în coș
                        </a>
                    </div>
                </div>
            </div>
        }

    </div>
</div>